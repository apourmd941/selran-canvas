# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
# (Note: the `lib/` ignores above are scoped to the repo root with a leading
# slash so they only match Python virtualenv layouts. The vendored canvas
# frontend libs at selran_canvas/canvas/lib/ are explicitly tracked.)
!selran_canvas/canvas/lib/
!selran_canvas/canvas/lib/*
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.env
.venv
env/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Selran Canvas runtime artifacts
canvas_state.db
canvas_state.db-journal
canvas_state.db-shm
canvas_state.db-wal
*.log

# All bundled CSL styles + the en-US locale ship with the repo for offline use.
# (To regenerate, delete and run: python -m selran_canvas.fetch_styles)
# Lazy-fetched additions beyond the manifest will land here too — they're caches
# and could be either committed (offline-friendly) or kept local. Default: commit them.

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
