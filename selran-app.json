{
  "selran_app_version": 1,
  "id": "canvas",
  "name": "Selran Canvas",
  "version": "2.0.0",
  "summary": "Page-aware companion canvas for Claude — manuscript pages, inline MCQ, and 100+ citation styles.",
  "tags": ["canvas", "companion", "manuscripts", "citations"],
  "category": "writing",
  "icon": "▢",
  "accent": "#F59E0B",
  "launch": {
    "kind": "spawn",
    "binary": "selran-canvas",
    "args": []
  },
  "then_open_url": "http://localhost:15000",
  "companion_starter": "python -m selran_canvas",
  "repo_path": "~/NeutronDev/Selran canvas skill platform",
  "mcp_skill_id": "canvas",
  "required": true,
  "install": {
    "source": { "kind": "bundled" },
    "egress": "local+server+cloud",
    "python": { "package": ".", "editable": true },
    "home": "~/.selran-canvas",
    "ports": 2,
    "db": { "kind": "postgres", "database": "canvas" },
    "env": { "CANVAS_DATABASE_URL": "${managed_pg_url}" }
  }
}
